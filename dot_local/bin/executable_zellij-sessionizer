#!/usr/bin/env bash

SEARCH_PATHS=(${ZELLIJ_SESSIONIZER_SEARCH_PATHS:-"$HOME/code"})
SPECIFIC_PATHS=(${ZELLIJ_SESSIONIZER_SPECIFIC_PATHS:-"$HOME/.local/share/chezmoi"})
OS_TYPE="${ZELLIJ_SESSIONIZER_OS_TYPE:-"$(uname)"}"
ZELLIJ_SWITCH_PLUGIN="${ZELLIJ_SESSIONIZER_SWITCH_PLUGIN:-"file:$HOME/.config/zellij/plugins/zellij-switch.wasm"}"

get_atime() {
	local dir="$1"
	if [[ "$OS_TYPE" == "Linux" ]]; then
		stat -c "%X" "$dir" 2>/dev/null || echo "0"
	else
		stat -f "%a" "$dir" 2>/dev/null || echo "0"
	fi
}

generate_display_list() {
  local all_dirs=()

  # Find git repositories at any depth in SEARCH_PATHS
  for search_path in "${SEARCH_PATHS[@]}"; do
    if [[ -d "$search_path" ]]; then
      while IFS= read -r gitdir; do
        all_dirs+=("$(dirname "$gitdir")")
      done < <(find "$search_path" -name .git -type d -prune 2>/dev/null)
    fi
  done

  # Add SPECIFIC_PATHS
  for specific_path in "${SPECIFIC_PATHS[@]}"; do
    if [[ -d "$specific_path" ]]; then
      all_dirs+=("$specific_path")
    fi
  done

  # Sort directories by last access time (most recent first)
  local temp_file
  temp_file=$(mktemp)
  for dir in "${all_dirs[@]}"; do
    local atime
    atime=$(get_atime "$dir")
    echo "$atime $dir" >> "$temp_file"
  done

  local sorted_dirs=()
  while IFS= read -r line; do
    sorted_dirs+=("${line#* }")
  done < <(sort -n "$temp_file")
  rm "$temp_file"

  # Get zellij session information
  declare -A session_status
  if command -v zellij >/dev/null 2>&1; then
    while IFS= read -r line; do
      if [[ -n "$line" ]]; then
        local session_name
        session_name=$(echo "$line" | awk '{print $1}')
        if [[ "$line" == *"(current)"* ]]; then
          session_status["$session_name"]=" $(tput setaf 2)(current)$(tput sgr0)"
        elif [[ "$line" == *"(EXITED"* ]]; then
          session_status["$session_name"]=" $(tput setaf 1)(exited)$(tput sgr0)"
        else
          session_status["$session_name"]=" $(tput setaf 3)(active)$(tput sgr0)"
        fi
      fi
    done < <(zellij ls -n 2>/dev/null)
  fi

  for dir in "${sorted_dirs[@]}"; do
    local display_name=${dir/#$HOME/\~}
    local session_name
    session_name=$(basename "$dir")
    if [[ -n "${session_status[$session_name]}" ]]; then
      display_name="${display_name}${session_status[$session_name]}"
    fi
    echo "$display_name"
  done
}

# Handle --generate-list for fzf reload
if [[ "$1" == "--generate-list" ]]; then
  generate_display_list
  exit 0
fi

# Extract session name from display line
extract_session_name() {
  local display_line="$1"
  local clean_path
  clean_path=$(echo "$display_line" | sed 's/ \x1b\[[0-9;]*m([^)]*)\x1b\[[0-9;]*m$//' | sed 's/ ([^)]*)$//')
  local full_path
  if [[ "$clean_path" == ~* ]]; then
    full_path="$HOME${clean_path:1}"
  else
    full_path="$clean_path"
  fi
  basename "$full_path"
}

# Resolve display line to full path
resolve_path() {
  local display_line="$1"
  local clean_path
  clean_path=$(echo "$display_line" | sed 's/ \x1b\[[0-9;]*m([^)]*)\x1b\[[0-9;]*m$//' | sed 's/ ([^)]*)$//')
  if [[ "$clean_path" == ~* ]]; then
    echo "$HOME${clean_path:1}"
  else
    echo "$clean_path"
  fi
}

# Create temp script for session operations
temp_script=$(mktemp)
cat > "$temp_script" << 'INNER'
#!/usr/bin/env bash
extract_session_name() {
  local display_line="$1"
  local clean_path
  clean_path=$(echo "$display_line" | sed 's/ \x1b\[[0-9;]*m([^)]*)\x1b\[[0-9;]*m$//' | sed 's/ ([^)]*)$//')
  local full_path
  if [[ "$clean_path" == ~* ]]; then
    full_path="$HOME${clean_path:1}"
  else
    full_path="$clean_path"
  fi
  basename "$full_path"
}
if [[ "$1" == "delete" ]]; then
  session_name=$(extract_session_name "$2")
  [[ -n "$session_name" ]] && zellij delete-session "$session_name" --force 2>/dev/null
fi
if [[ "$1" == "kill" ]]; then
  session_name=$(extract_session_name "$2")
  [[ -n "$session_name" ]] && zellij kill-session "$session_name" 2>/dev/null
fi
INNER
chmod +x "$temp_script"

selected_display=$(generate_display_list | fzf --ansi \
  --prompt="Select project: " \
  --header="Enter: Select | Ctrl+D: Delete | Ctrl+X: Kill" \
  --bind="ctrl-d:execute($temp_script delete {})+reload($0 --generate-list)" \
  --bind="ctrl-x:execute($temp_script kill {})+reload($0 --generate-list)")

rm -f "$temp_script"

[[ -z "$selected_display" ]] && exit 0

selected_dir=$(resolve_path "$selected_display")
session_name=$(basename "$selected_dir")

# Check for project-specific layout
layout_arg=""
if [[ -f "$selected_dir/.zellij.kdl" ]]; then
  layout_arg="--layout $selected_dir/.zellij.kdl"
fi

if [[ -n "$ZELLIJ" ]]; then
  zellij pipe --plugin "$ZELLIJ_SWITCH_PLUGIN" -- "--session $session_name --cwd $selected_dir $layout_arg"
else
  cd "$selected_dir" && zellij attach "$session_name" --create ${layout_arg:+$layout_arg}
fi
