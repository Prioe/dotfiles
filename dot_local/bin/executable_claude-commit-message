#!/usr/bin/env bash
set -euo pipefail

# Check for staged changes
if [ -z "$(git diff --cached --name-only)" ]; then
  echo "No staged changes found."
  exit 1
fi

# Combine git context and staged diff as input for Claude
input=$(printf '%s\n---\n%s' "$(git log --oneline -10)" "$(git diff --staged)")

# Generate commit messages using structured output
printf '%s' "$input" |
  claude --model haiku --output-format json --json-schema \
    '{"type":"object","properties":{"messages":{"type":"array","items":{"type":"string"}}},"required":["messages"]}' \
    -p 'Generate 5 concise git commit message options for these staged changes.
No markdown, no backticks, no numbering. Match the style from the git log above the ---.' |
  jq -r '.structured_output.messages[]'
