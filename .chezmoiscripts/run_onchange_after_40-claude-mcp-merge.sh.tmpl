#!/usr/bin/env bash
set -euo pipefail
set -x

{{ template "scriptLogging" . }}

# hash: {{ include "dot_config/claude/mcp.json" | sha256sum }}

# Paths
MCP_SOURCE="{{ .chezmoi.sourceDir }}/dot_config/claude/mcp.json"
CLAUDE_CONFIG_DIR="{{ .chezmoi.homeDir }}/.config/claude"
CLAUDE_CONFIG_FILE="$CLAUDE_CONFIG_DIR/.claude.json"

# Check if jq is available
{{ if lookPath "jq" }}
info "Merging Claude MCP configuration"


# Create .claude directory if it doesn't exist
mkdir -p "$CLAUDE_CONFIG_DIR"

# Check if the target config file exists
if [[ -f "$CLAUDE_CONFIG_FILE" ]]; then
    info "Merging with existing Claude configuration"
    # Merge configurations: keep existing config but replace mcpServers section
    jq -s '.[0] * .[1]' "$CLAUDE_CONFIG_FILE" "$MCP_SOURCE" > "$CLAUDE_CONFIG_FILE.tmp"
    mv "$CLAUDE_CONFIG_FILE.tmp" "$CLAUDE_CONFIG_FILE"
else
    info "Creating new Claude configuration"
    # No existing config, just copy the MCP config
    cp "$MCP_SOURCE" "$CLAUDE_CONFIG_FILE"
fi

info "Claude MCP configuration updated successfully"
{{ else }}
warn "jq not found in PATH, skipping Claude MCP configuration merge"
{{ end }}
