{{ if and .managePackages (or (eq (get .chezmoi.osRelease "id") "arch") (eq (get .chezmoi.osRelease "idLike") "arch")) -}}
#!/usr/bin/env bash
set -euo pipefail
{{ template "scriptLogging" . }}

{{- $packages := concat (.packages.archlinux.pacman) (.packages.archlinux.aur) }}
{{- if .gui }}
{{-   $packages = concat $packages (.packages.archlinux.gui) }}
{{- end }}
{{- if eq .chezmoi.os "linux" }}
{{-   if (.chezmoi.kernel.osrelease | lower | contains "microsoft") }}
{{-     $packages = concat $packages (.packages.archlinux.wsl) }}
{{-   end }}
{{- end }}
{{- if get . "pbsBackup" }}
{{-   $packages = concat $packages (.packages.archlinux.pbsBackup) }}
{{- end }}

info "Installing packages using paru"
paru -S --needed ${CI:+--noconfirm} {{ quoteList $packages | join " " }}

{{ end -}}

