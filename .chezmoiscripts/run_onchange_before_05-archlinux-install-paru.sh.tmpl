{{ if eq .chezmoi.osRelease.id "arch" -}}
#!/usr/bin/env bash
set -euo pipefail
{{ template "scriptLogging" . }}

{{- if lookPath "paru" | not }}
info "Installing paru AUR helper"

sudo pacman -S --needed git base-devel

tmpdir=$(mktemp -d)
trap 'rm -rf "$tmpdir"' EXIT

git clone https://aur.archlinux.org/paru-bin.git "$tmpdir/paru-bin"
cd "$tmpdir/paru-bin" || exit 1
makepkg -si

{{- else }}
info "paru is already installed, skipping installation"
{{- end }}

{{ end -}}

