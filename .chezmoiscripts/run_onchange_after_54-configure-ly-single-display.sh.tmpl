{{ if and .gui .managePackages (eq .chezmoi.hostname "coruscant") -}}
#!/usr/bin/env bash
set -euo pipefail
{{ template "scriptLogging" . }}

portrait_serial="312NTCZE2739"

# Install helper script to control DRM connector status by EDID serial
info "Installing ly-drm-ctl helper"
sudo tee /usr/local/bin/ly-drm-ctl > /dev/null << 'SCRIPT'
#!/bin/bash
# Toggle DRM connector status by EDID serial number.
# Usage: ly-drm-ctl <off|detect> <edid_serial>
set -euo pipefail
action="${1:?Usage: ly-drm-ctl <off|detect> <edid_serial>}"
serial="${2:?Usage: ly-drm-ctl <off|detect> <edid_serial>}"

for status_file in /sys/class/drm/card*-*/status; do
    dir=$(dirname "$status_file")
    edid_file="$dir/edid"
    [ -s "$edid_file" ] || continue
    if grep -qsa "$serial" "$edid_file"; then
        echo "$action" > "$status_file"
        exit 0
    fi
done
exit 0
SCRIPT
sudo chmod +x /usr/local/bin/ly-drm-ctl

# Systemd drop-in: disable portrait monitor before ly starts
info "Creating ly.service drop-in for single-display mode"
sudo mkdir -p /etc/systemd/system/ly.service.d
sudo tee /etc/systemd/system/ly.service.d/single-display.conf > /dev/null << EOF
[Service]
ExecStartPre=/usr/local/bin/ly-drm-ctl off $portrait_serial
EOF

# Allow passwordless sudo for the helper (needed by sway to re-enable)
info "Configuring sudoers for ly-drm-ctl"
echo "ALL ALL=(root) NOPASSWD: /usr/local/bin/ly-drm-ctl" | sudo tee /etc/sudoers.d/ly-drm-ctl > /dev/null
sudo chmod 440 /etc/sudoers.d/ly-drm-ctl

sudo systemctl daemon-reload
info "ly single-display configuration complete"
{{ end -}}
