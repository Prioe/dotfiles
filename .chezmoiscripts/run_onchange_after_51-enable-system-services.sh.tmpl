{{ if and .gui .managePackages (eq .chezmoi.osRelease.idLike "arch") -}}
#!/usr/bin/env bash
set -euo pipefail
{{ template "scriptLogging" . }}

# {{ include ".chezmoidata/packages.yml" | sha256sum }}

services=(
    swayosd-libinput-backend.service
)

for svc in "${services[@]}"; do
    if systemctl list-unit-files "$svc" &>/dev/null; then
        info "Enabling $svc"
        sudo systemctl enable --now "$svc"
    else
        warn "$svc not found, skipping"
    fi
done

# User services for graphical session (uwsm/sway)
user_services=(
    swayidle.service
    swayosd-server.service
    mako.service
)

for svc in "${user_services[@]}"; do
    if systemctl --user list-unit-files "$svc" &>/dev/null; then
        info "Enabling user service $svc"
        systemctl --user enable "$svc"
    else
        warn "User service $svc not found, skipping"
    fi
done
{{ end -}}
