{{ if eq .chezmoi.osRelease.id "arch" -}}
#!/usr/bin/env bash
set -euo pipefail
# shellcheck source=tools/script_logging.sh
. {{ joinPath .chezmoi.sourceDir "tools/script_logging.sh" }}
script_start

{{- $packages := concat (.packages.archlinux.pacman) (.packages.archlinux.aur) }}
{{- if eq .chezmoi.os "linux" }}
{{-   if (.chezmoi.kernel.osrelease | lower | contains "microsoft") }}
{{-     $packages = concat $packages (.packages.archlinux.wsl) }}
{{-   end }}
{{- end }}

info "Installing packages using paru"
paru -S --needed {{ quoteList $packages | join " " }}

script_end
{{ end -}}

