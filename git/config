	email = michael@prio.one
	name = Michael Albertz

[init]
	defaultBranch = main

[help]
	autocorrect = 1

[rerere]
	# Remember resolutions of conflicted merges
	enabled = true

[include]
	path = ~/.config/git/config.local
[filter "lfs"]
	smudge = git-lfs smudge -- %f
	process = git-lfs filter-process
	required = true
	clean = git-lfs clean -- %f
