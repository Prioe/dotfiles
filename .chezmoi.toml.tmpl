# Set the defaults
{{- $email := "michael@prio.one" }}
{{- $gui := false }}
{{- $managePackages := env "CHEZMOI_MANAGE_PACKAGES" | not | not }}
{{- $notesRepoUrl := "" }}

# Detect environment (used as defaults)
{{- $isContainer := or (stat "/.dockerenv") (stat "/run/.containerenv") (eq .chezmoi.hostname "buildkitsandbox") | not | not }}
{{- $hasOP := or (lookPath "op") (lookPath "op.exe") | not | not }}

# Prompt for configurable values (uses defaults if non-interactive)
{{- $isWSL := and (not $isContainer) (.chezmoi.kernel.osrelease | lower | contains "microsoft") }}

{{- if stdinIsATTY }}
{{-   $email = promptStringOnce . "email" "What is your email address" $email }}
{{-   $gui = promptBoolOnce . "gui" "Do you want to include gui applications" $gui }}
{{-   $managePackages = promptBoolOnce . "managePackages" "Do you want chezmoi to manage your system-packages?" $managePackages }}
{{-   $notesRepoUrl = promptStringOnce . "notesRepoUrl" "Git URL for notes repo (leave empty to skip)" }}
{{- end }}

[data]
email = {{ $email | quote }}
gui = {{ $gui }}
managePackages = {{ $managePackages }}
isContainer = {{ $isContainer }}
isWSL = {{ $isWSL }}
hasOP = {{ $hasOP }}
notesRepoUrl = {{ $notesRepoUrl | quote }}

{{- if $isWSL }}

[onepassword]
command = "op.exe"
{{- end }}

