include ../catppuccin-mocha

# Logo key (Mod4 = Super). Use Mod1 for Alt.
set $mod Mod4

# Vim key support
set $left h
set $down j
set $up k
set $right l

# Default applications (uwsm app -- ensures proper systemd scoping)
set $term uwsm app -- ghostty +new-window
set $menu uwsm app -- rofi -show combi
set $powermenu ~/.config/sway/scripts/power_menu.sh

# Monitor aliases (kept in sync with kanshi config)
set $coruscant_portrait "LG Electronics LG ULTRAGEAR 312NTCZE2739"
set $coruscant_landscape "LG Electronics LG ULTRAGEAR 311NTABA3392"

