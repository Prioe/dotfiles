{
  "$schema": "https://json.schemastore.org/claude-code-settings.json",
  "attribution": {
    "commit": "",
    "pr": ""
  },
  "permissions": {
    "defaultMode": "auto",
    "allow": [
      "Bash(npm run build)",
      "Bash(npm run test:*)",
      "Bash(cat:*)",
      "Bash(head:*)",
      "Bash(tail:*)",
      "Bash(tree:*)",
      "Bash(wc:*)",
      "Bash(git status:*)",
      "Bash(git log:*)",
      "Bash(git diff:*)",
      "Bash(git show:*)",
      "Bash(git branch:*)",
      "Bash(git stash:*)",
      "Bash(git add:*)",
      "Bash(git rm:*)",
      "Bash(git ls-files:*)",
      "Bash(git rev-parse:*)",
      "Bash(git rev-list:*)",
      "Bash(git reflog:*)",
      "Bash(git remote:*)",
      "Bash(git fetch:*)",
      "Bash(git tag:*)",
      "Bash(git lfs:*)",
      "Bash(git config:*)",
      "Bash(gh:*)",
      "Bash(ls:*)",
      "Bash(pwd)",
      "Bash(file:*)",
      "Bash(grep:*)",
      "Bash(rg:*)",
      "Bash(find:*)",
      "Bash(fd:*)",
      "Bash(jq:*)",
      "Bash(languagetool:*)",
      "mcp__context7__get-library-docs",
      "mcp__context7__resolve-library-id",
      "Bash(* --version)",
      "Bash(* --help)",
      "Skill(creating-zettel)",
      "Skill(managing-daily-notes)",
      "Skill(searching-zettel)"
    ],
    "deny": [
      "Bash(sudo:*)",
      "Read(id_rsa)",
      "Read(id_ed25519)",
      "Read(**/*token*)",
      "Read(**/*key*)"
    ],
    "ask": [
      "Bash(rm:*)",
      "Bash(rm -rf:*)",
      "Bash(git push:*)",
      "Bash(git reset:*)",
      "Bash(git rebase:*)",
      "Bash(git commit:*)",
      "Bash(git -C*commit:*)",
      "Bash(git -C*push:*)",
      "Bash(git -C*reset:*)",
      "Bash(git -C*rebase:*)",
      "Bash(glab mr create:*)",
      "Bash(glab mr update:*)",
      "Bash(glab mr note:*)",
      "Bash(glab mr merge:*)",
      "Bash(glab mr close:*)",
      "Bash(glab issue create:*)",
      "Bash(glab issue update:*)",
      "Bash(glab issue note:*)",
      "Bash(glab issue close:*)",
      "Bash(glab release create:*)",
      "Bash(gh pr create:*)",
      "Bash(gh pr edit:*)",
      "Bash(gh pr comment:*)",
      "Bash(gh pr merge:*)",
      "Bash(gh issue create:*)",
      "Bash(gh issue edit:*)",
      "Bash(gh issue comment:*)",
      "Bash(gh release create:*)",
      "Read(.env*)",
      "Write(.env*)",
      "Bash(curl:*)",
      "Bash(wget:*)",
      "Bash(nc:*)",
      "Bash(psql:*)",
      "Bash(mysql:*)",
      "Bash(mongod:*)"
    ]
  },
  "model": "fable",
  "hooks": {
    "PreToolUse": [],
    "PostToolUse": [],
    "Notification": [],
    "Stop": []
  },
  "statusLine": {
    "type": "command",
    "command": "bash -c 'cols=${COLUMNS:-}; case \"$cols\" in \"\"|*[!0-9]*) cols=$(stty size </dev/tty 2>/dev/null | awk '\"'\"'{print $2}'\"'\"');; esac; case \"$cols\" in \"\"|*[!0-9]*) cols=120;; esac; export COLUMNS=$(( cols > 4 ? cols - 4 : 1 )); plugin_dir=$(ls -d \"${CLAUDE_CONFIG_DIR:-$HOME/.claude}\"/plugins/cache/*/claude-hud/*/ 2>/dev/null | awk -F/ '\"'\"'{ print $(NF-1) \"\\t\" $(0) }'\"'\"' | grep -E '\"'\"'^[0-9]+\\.[0-9]+\\.[0-9]+[[:space:]]'\"'\"' | sort -t. -k1,1n -k2,2n -k3,3n -k4,4n | tail -1 | cut -f2-); exec \"/home/micha/.local/share/mise/installs/node/lts/bin/node\" \"${plugin_dir}dist/index.js\"'",
    "refreshInterval": 5
  },
  "enabledPlugins": {
    "elements-of-style@superpowers-marketplace": false,
    "clangd-lsp@claude-plugins-official": false,
    "code-review@claude-plugins-official": true,
    "typescript-lsp@claude-plugins-official": false,
    "rust-analyzer-lsp@claude-plugins-official": false,
    "claude-hud@claude-hud": true
  },
  "extraKnownMarketplaces": {
    "claude-hud": {
      "source": {
        "source": "github",
        "repo": "jarrodwatts/claude-hud"
      }
    }
  },
  "forceLoginMethod": "claudeai",
  "alwaysThinkingEnabled": true,
  "feedbackSurveyState": {
    "lastShownTime": 1754055893862
  },
  "effortLevel": "high",
  "tui": "fullscreen",
  "editorMode": "vim",
  "skipAutoPermissionPrompt": true,
  "skillOverrides": {
    "caveman": "off",
    "diagnose": "off",
    "improve-codebase-architecture": "off",
    "prototype": "off",
    "tdd": "off",
    "triage": "off",
    "to-issues": "off",
    "to-prd": "off",
    "zoom-out": "off",
    "setup-matt-pocock-skills": "off",
    "write-a-skill": "off",
    "sync-validation-progress": "off",
    "preparing-standup": "off"
  },
  "env": {
    "DISABLE_INSTALLATION_CHECKS": "1"
  }
}
