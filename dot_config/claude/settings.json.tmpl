{{- $settings := includeTemplate "claude-settings.json" . | fromJson -}}
{{- $workFile := joinPath .chezmoi.homeDir ".config/claude/settings.work.json" -}}
{{- if stat $workFile -}}
{{- /* Deep merge: work values win, but work lists replace base lists instead of extending them */ -}}
{{-   $settings = mergeOverwrite $settings (include $workFile | fromJson) -}}
{{- end -}}
{{ toPrettyJson "  " $settings }}
