// -*- mode: jsonc -*-
{
  "layer": "top",
  "position": "top",
  "spacing": 8,

  // -- Left -------------------------------------------------------------------
  "modules-left": ["custom/main-menu", "sway/workspaces", "sway/mode", "sway/window"],

  "custom/main-menu": {
    "format": "󰍜",
    "menu": "on-click",
    "menu-file": "~/.config/waybar/main_menu.xml",
    "menu-actions": {
      "keyhints": "~/.config/waybar/scripts/keyhint.sh",
      "restore-vertical-layout": "~/.config/sway/scripts/restore-vertical-layout.sh"
    },
    "tooltip": false
  },

  "sway/workspaces": {
    "disable-scroll": true,
    "all-outputs": true,
    "format": "{icon}",
    "format-icons": {
      "3": "3",
      "4": "4",
      "5": "5",
      "6": "6",
      "7": "7",
      "8": "8",
      "9": "9",
      "10": "10"
    }
  },

  "sway/mode": {
    "format": "<span style=\"italic\">{}</span>",
    "tooltip": false
  },

  "sway/window": {
    "format": "{}",
    "max-length": 120
  },

  // -- Center -----------------------------------------------------------------
  "modules-center": [],

  "network": {
    "format-disabled": " Disabled",
    "format-wifi": " {bandwidthDownBits:>} 󰶡 {bandwidthUpBits:>} 󰶣",
    "tooltip-format-wifi": "{essid} ({signalStrength}%)\n{ifname}: {ipaddr}/{cidr}",
    "format-ethernet": "󰈀 {bandwidthDownBits:>} 󰶡 {bandwidthUpBits:>} 󰶣",
    "tooltip-format-ethernet": "{ifname}: {ipaddr}/{cidr}\nvia {gwaddr}",
    "format-disconnected": " Disconnected",
    "on-click": "ghostty -e nmtui",
    "interval": 2
  },

  // -- Right ------------------------------------------------------------------
  "modules-right": [
    "idle_inhibitor",
    "cpu",
    "memory",
    "backlight",
    "pulseaudio",
    "network",
    "battery",
    "clock",
    "tray",
    "custom/power"
  ],

  "idle_inhibitor": {
    "format": "{icon}",
    "format-icons": {
      "activated": "󰅶",
      "deactivated": "󰛊"
    },
    "tooltip-format-activated": "Idle inhibitor active",
    "tooltip-format-deactivated": "Idle inhibitor inactive"
  },

  "cpu": {
    "interval": 5,
    "format": "{usage:>3}%",
    "states": {
      "warning": 70,
      "critical": 90
    },
    "on-click": "ghostty -e htop"
  },

  "memory": {
    "interval": 5,
    "format": "{:>3}%",
    "states": {
      "warning": 70,
      "critical": 90
    },
    "on-click": "ghostty -e htop"
  },

  "backlight": {
    "format": "{icon} {percent}%",
    "format-icons": ["󰃞", "󰃟", "󰃠"],
    "tooltip-format": "Brightness (scroll): {percent}%",
    "on-scroll-down": "brightnessctl -c backlight set 5%-",
    "on-scroll-up": "brightnessctl -c backlight set +5%"
  },

  "pulseaudio": {
    "scroll-step": 2,
    "format": "{icon} {volume}%",
    "format-muted": "󰝟 muted",
    "format-icons": {
      "headphone": "",
      "hands-free": "",
      "headset": "",
      "phone": "",
      "portable": "",
      "car": "",
      "default": ["󰕿", "󰖀", "󰕾"]
    },
    "on-click": "pavucontrol"
  },

  "battery": {
    "states": {
      "warning": 30,
      "critical": 15
    },
    "format": "{icon} {capacity}%",
    "format-charging": "󰂄 {capacity}%",
    "format-plugged": "󰂄 {capacity}%",
    "format-icons": ["", "", "", "", ""]
  },

  "clock": {
    "format": "󰅐 {:%H:%M}",
    "format-alt": "󰅐 {:%A, %d %B %Y}",
    "tooltip-format": " {:%A %d/%m}\n\n<tt><small>{calendar}</small></tt>",
    "calendar": {
      "on-scroll": 1,
      "format": {
        "months": "<span color='#f5e0dc'><b>{}</b></span>",
        "days": "<span color='#cdd6f4'>{}</span>",
        "weeks": "<span color='#94e2d5'><b>W{}</b></span>",
        "weekdays": "<span color='#f9e2af'><b>{}</b></span>",
        "today": "<span color='#f38ba8'><b><u>{}</u></b></span>"
      }
    },
    "actions": {
      "on-scroll-up": "shift_up",
      "on-scroll-down": "shift_down"
    }
  },

  "tray": {
    "icon-size": 16,
    "spacing": 10
  },

  "custom/power": {
    "format": "⏻",
    "menu": "on-click",
    "menu-file": "~/.config/waybar/power_menu.xml",
    "menu-actions": {
      "lock": "swaylock",
      "suspend": "systemctl suspend",
      "logout": "uwsm stop",
      "reboot": "systemctl reboot",
      "uefi": "systemctl reboot --firmware-setup",
      "shutdown": "systemctl poweroff"
    },
    "tooltip": false
  }
}
