keybinds clear-defaults=true {
    locked {
        bind "Ctrl Space" { SwitchToMode "Normal"; }

        // Pane navigation via vim-zellij-navigator (neovim-aware)
        bind "Ctrl h" {
            MessagePlugin "file:~/.config/zellij/plugins/vim-zellij-navigator.wasm" {
                name "move_focus";
                payload "left";
                move_mod "ctrl";
            };
        }
        bind "Ctrl j" {
            MessagePlugin "file:~/.config/zellij/plugins/vim-zellij-navigator.wasm" {
                name "move_focus";
                payload "down";
                move_mod "ctrl";
            };
        }
        bind "Ctrl k" {
            MessagePlugin "file:~/.config/zellij/plugins/vim-zellij-navigator.wasm" {
                name "move_focus";
                payload "up";
                move_mod "ctrl";
            };
        }
        bind "Ctrl l" {
            MessagePlugin "file:~/.config/zellij/plugins/vim-zellij-navigator.wasm" {
                name "move_focus";
                payload "right";
                move_mod "ctrl";
            };
        }
    }

    normal {
        bind "Esc" "Ctrl Space" { SwitchToMode "Locked"; }

        // Tab/window switching by number
        bind "1" { GoToTab 1; SwitchToMode "Locked"; }
        bind "2" { GoToTab 2; SwitchToMode "Locked"; }
        bind "3" { GoToTab 3; SwitchToMode "Locked"; }
        bind "4" { GoToTab 4; SwitchToMode "Locked"; }
        bind "5" { GoToTab 5; SwitchToMode "Locked"; }
        bind "6" { GoToTab 6; SwitchToMode "Locked"; }
        bind "7" { GoToTab 7; SwitchToMode "Locked"; }
        bind "8" { GoToTab 8; SwitchToMode "Locked"; }
        bind "9" { GoToTab 9; SwitchToMode "Locked"; }

        // Session switcher (Ctrl held after prefix)
        bind "Ctrl j" {
            Run "zellij-sessionizer" {
                close_on_exit true
                floating true
                x "20%"
                y "10%"
                width "60%"
                height "80%"
            };
            SwitchToMode "Locked"
        }

        // Built-in session manager
        bind "Ctrl o" {
            LaunchOrFocusPlugin "zellij:session-manager" {
                floating true
                move_to_focused_tab true
            };
            SwitchToMode "Locked"
        }

        // Splits
        bind "v" { NewPane "Right"; SwitchToMode "Locked"; }
        bind "s" { NewPane "Down"; SwitchToMode "Locked"; }

        // New tab
        bind "c" { NewTab; SwitchToMode "Locked"; }

        // Close pane / tab
        bind "x" { CloseFocus; SwitchToMode "Locked"; }
        bind "X" { CloseTab; SwitchToMode "Locked"; }

        // Detach
        bind "d" { Detach; }

        // Pane navigation (vim style)
        bind "h" { MoveFocus "Left"; SwitchToMode "Locked"; }
        bind "j" { MoveFocus "Down"; SwitchToMode "Locked"; }
        bind "k" { MoveFocus "Up"; SwitchToMode "Locked"; }
        bind "l" { MoveFocus "Right"; SwitchToMode "Locked"; }

        // Resize (shift + vim keys, stays in normal for repeated resizing)
        bind "H" { Resize "Increase Left"; }
        bind "J" { Resize "Increase Down"; }
        bind "K" { Resize "Increase Up"; }
        bind "L" { Resize "Increase Right"; }

        // Fullscreen / floating
        bind "z" { ToggleFocusFullscreen; SwitchToMode "Locked"; }
        bind "f" { ToggleFloatingPanes; SwitchToMode "Locked"; }

        // Move tab left/right
        bind "[" { MoveTab "Left"; }
        bind "]" { MoveTab "Right"; }

        // Scroll mode
        bind "&" { SwitchToMode "Scroll"; }

        // Rename tab
        bind "," { SwitchToMode "RenameTab"; TabNameInput 0; }

        // Next/previous tab
        bind "n" { GoToNextTab; SwitchToMode "Locked"; }
        bind "p" { GoToPreviousTab; SwitchToMode "Locked"; }

        // Toggle last tab
        bind "Tab" { ToggleTab; }

        // Break pane into its own tab
        bind "b" { BreakPane; SwitchToMode "Locked"; }

        // Sync panes
        bind "e" { ToggleActiveSyncTab; SwitchToMode "Locked"; }

        // Keybinding cheatsheet
        bind "?" {
            LaunchOrFocusPlugin "zellij-forgot" {
                floating true
                move_to_focused_tab true
            };
            SwitchToMode "Locked"
        }
    }

    scroll {
        bind "Esc" "Ctrl Space" { SwitchToMode "Locked"; }
        bind "j" "Down" { ScrollDown; }
        bind "k" "Up" { ScrollUp; }
        bind "Ctrl d" { HalfPageScrollDown; }
        bind "Ctrl u" { HalfPageScrollUp; }
        bind "Ctrl f" "PageDown" { PageScrollDown; }
        bind "Ctrl b" "PageUp" { PageScrollUp; }
        bind "/" { SwitchToMode "EnterSearch"; SearchInput 0; }
        bind "G" { ScrollToBottom; SwitchToMode "Locked"; }
        bind "e" { EditScrollback; SwitchToMode "Locked"; }
    }

    entersearch {
        bind "Esc" "Ctrl c" { SwitchToMode "Scroll"; }
        bind "Enter" { SwitchToMode "Search"; }
    }

    search {
        bind "Esc" "Ctrl Space" { SwitchToMode "Locked"; }
        bind "j" "Down" { ScrollDown; }
        bind "k" "Up" { ScrollUp; }
        bind "Ctrl d" { HalfPageScrollDown; }
        bind "Ctrl u" { HalfPageScrollUp; }
        bind "Ctrl f" "PageDown" { PageScrollDown; }
        bind "Ctrl b" "PageUp" { PageScrollUp; }
        bind "n" { Search "down"; }
        bind "N" { Search "up"; }
        bind "c" { SearchToggleOption "CaseSensitivity"; }
        bind "w" { SearchToggleOption "Wrap"; }
        bind "o" { SearchToggleOption "WholeWord"; }
    }

    renametab {
        bind "Esc" { UndoRenameTab; SwitchToMode "Locked"; }
        bind "Enter" { SwitchToMode "Locked"; }
    }
}

plugins {
    zjstatus location="file:~/.config/zellij/plugins/zjstatus.wasm" {
        // Catppuccin Mocha
        color_bg "#1e1e2e"
        color_fg "#cdd6f4"
        color_surface0 "#313244"
        color_surface1 "#45475a"
        color_overlay0 "#6c7086"
        color_red "#f38ba8"
        color_green "#a6e3a1"
        color_yellow "#f9e2af"
        color_blue "#89b4fa"
        color_mauve "#cba6f7"
        color_peach "#fab387"
        color_teal "#94e2d5"
        color_lavender "#b4befe"

        format_left  "{mode} {tabs}"
        format_center ""
        format_right "{pipe_zjstatus_hints}{datetime}#[bg=$lavender,fg=$bg,bold] {session} "
        format_space ""
        format_hide_on_overlength "true"
        format_precedence "lrc"

        pipe_zjstatus_hints_format "{output}"

        border_enabled "false"
        hide_frame_for_single_pane "true"

        // Mode indicators
        mode_locked        "#[fg=$overlay0] {name}"
        mode_normal        "#[bg=$green,fg=$bg,bold] {name} "
        mode_scroll        "#[bg=$blue,fg=$bg,bold] {name} "
        mode_search        "#[bg=$yellow,fg=$bg,bold] {name} "
        mode_enter_search  "#[bg=$yellow,fg=$bg,bold] SEARCH "
        mode_rename_tab    "#[bg=$mauve,fg=$bg,bold] {name} "

        // Tabs
        tab_active              "#[bg=$peach,fg=$bg,bold] {index} {name} "
        tab_active_fullscreen   "#[bg=$peach,fg=$bg,bold] {fullscreen_indicator} {index} {name} "
        tab_active_sync         "#[bg=$peach,fg=$bg,bold] {sync_indicator} {index} {name} "

        tab_normal              "#[fg=$overlay0,bold] {index} {name} "
        tab_normal_fullscreen   "#[fg=$overlay0,bold] {fullscreen_indicator} {index} {name} "
        tab_normal_sync         "#[fg=$overlay0,bold] {sync_indicator} {index} {name} "

        tab_separator " "

        tab_sync_indicator       "󰓦"
        tab_fullscreen_indicator "󰊓"
        tab_floating_indicator   "⬚"

        tab_rename "#[bg=$blue,fg=$bg,bold] {index} {name} {floating_indicator} "

        tab_display_count         "15"
        tab_truncate_start_format "#[fg=$yellow]  +{count}  "
        tab_truncate_end_format   "#[fg=$yellow]   +{count} "

        // Right side
        datetime "#[fg=$overlay0,bold] {format} "
        datetime_format "%H:%M"
        datetime_timezone "Europe/Berlin"
    }

    zjstatus-hints location="file:~/.config/zellij/plugins/zjstatus-hints.wasm" {
        max_length 180
        overflow_str ""
        pipe_name "zjstatus_hints"
        hide_in_base_mode true
    }

    zellij-forgot location="file:~/.config/zellij/plugins/zellij-forgot.wasm"
    vim-zellij-navigator location="file:~/.config/zellij/plugins/vim-zellij-navigator.wasm"
}

load_plugins {
    zjstatus-hints
    vim-zellij-navigator
}

default_mode "locked"
default_layout "default"
theme "catppuccin-mocha"
show_startup_tips false
session_serialization true
serialize_pane_viewport true
scrollback_editor "nvim"

// zellij-autolock: auto-lock when nvim/fzf/atuin are running
// To enable, uncomment the load_plugins block below and add the WASM plugin
// to .chezmoiexternal.toml.tmpl
