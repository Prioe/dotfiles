{{- if .hasOP }}
{{- $item := printf "op://%s/%s %s" .pbs.opVault .pbs.opItemPrefix .chezmoi.hostname -}}
[Service]
Environment=PBS_REPOSITORY={{ onepasswordRead (printf "%s/repository" $item) }}
Environment=PBS_FINGERPRINT={{ onepasswordRead (printf "%s/fingerprint" $item) }}
Environment=PBS_PASSWORD={{ onepasswordRead (printf "%s/credential" $item) }}
Environment=PBS_NAMESPACE={{ onepasswordRead (printf "%s/namespace" $item) }}
{{ end -}}
